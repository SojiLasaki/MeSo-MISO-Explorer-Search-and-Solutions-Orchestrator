# Never put this value in the React application or commit a real .env file.
MISO_API_BASE_URL=https://apim.misoenergy.org
MISO_SUBSCRIPTION_KEY=
MISO_REQUEST_TIMEOUT_SECONDS=30
DJANGO_SECRET_KEY=change-this-for-local-development
DJANGO_DEBUG=true
CORS_ALLOWED_ORIGINS=https://your-web-frontend.example
# Shared only by the deployed Web Data Agent and the separately installed
# Local Integration Agent. It signs work instructions; it is not a MISO key.
LOCAL_AGENT_SHARED_SECRET=change-this-before-production
LOCAL_AGENT_TOKEN=replace-with-a-long-local-agent-token
